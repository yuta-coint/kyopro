import copy
import math
def gcd(s,t):
    if s != 0 and t!= 0:
        return(math.gcd(s,t))
    else:
        return(max(s,t))
#セグ木
N=int(input())
p = 1
np = (N-1).bit_length()
segtree = [[] for i in range(np+1)]
segtree[0] = list(map(int,input().split()))
segtree[0] += [0]*(2**np-N)
for i in range(1,np+1):
