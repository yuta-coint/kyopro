import sys
input = sys.stdin.readline
n,k = map(int,input().split())
s = [int(input()) for i in range(n)]
window = s[0]
size = 1
ar = 1
al = 0
ans = 0
if 0 in s:
    ans = n
elif k==0:
    ans = 0
else:
    while ar < n and al<n:
        if window > k:
            window //= s[al]
            al += 1
            size -=1
        else:
            if size > ans:
                ans = size
            window *= s[ar]
            ar += 1
            size += 1
    if window <= k and size > ans:
        ans = size
print(ans)
