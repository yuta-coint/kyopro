n = int(input())
a = list(map(int,input().split()))
b = list(map(int,input().split()))
MOD = 998244353
M = max(b)
pat = [0 for i in range(M+1)]
cnt = 0
for i in range(a[0],b[0]+1):
    cnt += 1
    pat[i] = cnt
for i in range(b[0]+1,M+1):
    pat[i]=pat[i-1]
for i in range(1,n):
    for j in range(a[i]+1,b[i]+1):
        pat[j] = pat[j]+pat[j-1]
        pat[j] %= 998244353
    for j in range(b[i]+1,M+1):
        pat[j]=pat[j-1]
