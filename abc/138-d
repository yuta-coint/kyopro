import sys
sys.setrecursionlimit(300000)
n,q = map(int, sys.stdin.readline().split())
G = [[]for i in range(n+1)]
for i in range(1,n):
    u,v = map(int, sys.stdin.readline().split())
    G[u].append(v)
    G[v].append(u)
chk = [0 for i in range(n+1)]
plus = [0 for i in range(n+1)]
counter = [0 for i in range(n+1)]
for i in range(q):
    p,x = map(int, sys.stdin.readline().split())
    plus[p]+=x

d = 0
def dfs(v):
    global d
    chk[v] = 1
    d += plus[v]
    counter[v] = d
    for i in G[v]:
        if chk[i]==0:
            dfs(i)
    d -= plus[v]
dfs(1)
counter = counter[1:]
#print(plus)
print(*counter)
