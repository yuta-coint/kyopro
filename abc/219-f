import copy
s = list(input())
point = [0,0]
route = [(0,0)]
route = set(route)
for i in s:
    if i=="U":
        point[1]+=1
    elif i == "D":
        point[1]-=1
    elif i == "R":
        point[0]+=1
    elif i == "L":
        point[0]-=1
    t = tuple(point)
    route.add(t)
route2 = copy.copy(route)
ans = len(route)
allroute = copy.copy(route)
point2 = copy.copy(point)
flag = 10**9
preflag = 0
time = 0
k = int(input())
while preflag !=flag and time <k-1:
    route2 = list(route2)
    for i in range(len(route2)):
        j = list(route2[i])
        j[0] += point2[0]
        j[1] += point2[1]
        route2[i] = tuple(j)
    route2 = set(route2)
    #print(route2)
    #print(allroute)
    route2 = route2 - allroute
    #print(route2)
    allroute = allroute & route2
    preflag = flag
    flag = len(route2)
    ans += flag
    time += 1
ans += (k-time-1)*flag
print(ans)
