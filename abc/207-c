import math
n = int(input())
ans = 0
area=[]
for i in range(n):
    a= list(map(int,input().split()))
    area.append(a)
for i in range(n-1):
    j = i+1
    while j < n:
        flag = 0
        areai = area[i]
        areaj = area[j]
        ti = areai[0]
        tj = areaj[0]
        li = areai[1]
        lj = areaj[1]
        ri = areai[2]
        rj = areaj[2]
        if ri < lj or rj < li:
            flag = 0
        elif ri > lj and rj > li:
            flag = 1
        elif ri == lj:
            if tj < 3 and ti%2 == 1:
                flag=1
        else:
            if ti < 3 and tj%2 == 1:
                flag=1
        ans += flag
        j +=1
print(ans)
