import queue
n,q =map(int, input().split())
graph = [[] for i in range(n+1)]
color = [0 for i in range(n+1)]
for i in range(n-1):
    a,b = map(int,input().split())
    graph[a].append(b)
    graph[b].append(a)
color[1]=1
new = queue.Queue()
new.put(1)
for i in range(1,n+1):
    k = new.get()
    for j in graph[k]:
        if color[j]==0:
            color[j]=(-1)*color[k]
            new.put(j)
for i in range(q):
    c, d = map(int,input().split())
    if color[c]==color[d]:
        print("Town")
    else:
        print("Road")
