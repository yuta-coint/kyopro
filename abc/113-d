h,w,k=map(int,input().split())
mod = 10**9+7
pattern = [1,2]
for i in range(1,w):
    pattern.append((pattern[i]+pattern[i-1])%mod)
#print(pattern)
amida = [[0 for i in range(h+1)]for j in range(w)]
amida[0][0]=1
if w == 1:
    print(1)
elif w==2:
    ans = 1
    for i in range(h-1):
        ans *= 2
        ans %= mod
else:
    for j in range(h):
        amida[0][j+1]=(amida[0][j]*pattern[w-2])+(amida[1][j]*pattern[w-3])
        amida[w-1][j+1]=(amida[w-1][j]*pattern[w-2])+(amida[w-2][j]*pattern[w-3])
        for i in range(1,w-1):
            amida[i][j+1] += amida[i][j]*pattern[i-1]*pattern[w-2-i]
            if i == 1:
                amida[i][j+1] += amida[i-1][j]*pattern[w-2-i]
            else:
                amida[i][j+1] += amida[i-1][j]*pattern[i-2]*pattern[w-2-i]
            if i == w-2:
                amida[i][j+1] += amida[i+1][j]*pattern[i-1]
            else:
                amida[i][j+1] += amida[i+1][j]*pattern[i-1]*pattern[w-3-i]
        for i in range(w):
            amida[i][j] %= mod
    #print(amida)
    print(amida[k-1][h]%mod)
