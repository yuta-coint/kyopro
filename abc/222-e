import sys
sys.setrecursionlimit(300000)
MOD = 998244353
n,m,k = map(int,input().split())
a = list(map(int,input().split()))
G = [[]for i in range(n+1)]
for i in range(1,n):
    u,v = map(int,input().split())
    G[u].append(v)
    G[v].append(u)
chk = [0 for i in range(n+1)]
mother = [0 for i in range(n+1)]
depth = [0 for i in range(n+1)]
d = 0
def dfs(v):
    global d
    global chk
    global mother
    global depth
    chk[v] = 1
    depth[v] = d
    d += 1
    for i in G[v]:
        if chk[i]==0:
            mother[i] = v
            dfs(i)
    d -= 1

dfs(1)

cnt = [0 for i in range(n+1)]
for i in range(m-1):
    p = a[i]
    q = a[i+1]
    while p != q:
        if depth[p]>=depth[q]:
            cnt[p]+=1
            p = mother[p]
        else:
            cnt[q] += 1
            q = mother[q]

target = sum(cnt) - k
if target%2 == 1 or target<0:
    print(0)
else:
    target//=2
    ans= [0 for i in range(target+1)]
    ans[0] = 1
    for i in range(2,n+1):
        for j in reversed(range(cnt[i],target+1)):
            ans[j] +=ans[j-cnt[i]]
            ans[j]%=MOD
    print(ans[target])
