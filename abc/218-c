        for i in range(n):
            if t[i][k]=="#":
                flag = 1
        k += 1
    for i in range(n):
        t[i] = t[i][k-1:]+t[i][:k-1]
    flag = 0
    k = 0
    while flag == 0 and k<n:
        for i in range(n):
            if t[k][i]=="#":
                flag = 1
        k += 1
    t = t[k-1:]+t[:k-1]
    check.append(t)
