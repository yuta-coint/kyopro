n = int(input())
s = input()
ans = [0 for i in range(3*n)]
s1 = s[:n]
s2 = s[n:2*n]
s3 = s[2*n:]
abc = [0,0,0,0,0,0]
t = [0,0,0,0,0,0]
abc[0] = s1.count("A")
abc[1] = s1.count("B")
abc[2] = s1.count("C")
abc[3] = s2.count("A")
abc[4] = s2.count("B")
abc[5] = s2.count("C")
t[1] = abc[0]
t[2] = abc[5]-t[1]
t[3] = abc[1]-t[2]
t[4] = abc[3]-t[3]
t[5] = abc[2]-t[4]
m1 = min(t[0],t[2],t[4])
m2 = min(t[1],t[3],t[5])
if m1<0:
    t[0]-=m1
    t[2]-=m1
    t[4]-=m1
    t[1]+=m1
    t[3]+=m1
    t[5]+=m1
if m2<0:
    t[0]+=m2
    t[2]+=m2
    t[4]+=m2
    t[1]-=m2
    t[3]-=m2
    t[5]-=m2
cnt = [[t[0],t[2],t[4]],[t[3],t[0],t[1]],[t[2],t[1],t[0]]]
a = [[[1,2],[3,4],[5,6]],[[4,5],[1,6],[2,3]],[[3,6],[2,5],[1,4]]]
ABC=["A","B","C"]
for j in range(3):
    c = [0,0,0]
    c[0] = cnt[j][0]
    c[1] = cnt[j][1]
    c[2] = cnt[j][2]
    for i in range(n):
        for k in range(3):
            if s[j*n+i]==ABC[k]:
                if c[k]>0:
                    ans[j*n+i]=a[j][k][0]
                    c[k]-=1
                else:
                    ans[j*n+i]=a[j][k][1]
print(*ans,sep="")
