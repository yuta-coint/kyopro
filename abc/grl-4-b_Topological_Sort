def TopologicalSort(G,N):
    rG = [set() for i in range(N)]
    for i in range(N):
        for j in G[i]:
            rG[j].add(i)
    inedge = [len(rG[i]) for i in range(N)]
    L = []
    import queue
    S = queue.Queue()
    for i in range(N):
        if inedge[i]==0:
            S.put(i)
    while not S.empty():
        n = S.get()
        L.append(n)
        for i in G[n]:
            inedge[i] -= 1
            if inedge[i] == 0:
                S.put(i)
    if N==len(L):
        return(L)
    else:
        return(-1)
N,e = map(int,input().split())
G = [set() for i in range(N)]
for i in range(e):
    s,t= map(int,input().split())
    G[s].add(t)
ans = TopologicalSort(G,N)
for i in range(N):
    print(ans[i])

