n,a = map(int,input().split())
x=list(map(int,input().split()))
pat = [[0 for i in range(a*n+1)] for j in range(n+1)]
pat[0][0]=1
for i in range(n):
    for j in reversed(range(1,n+1)):
        for k in range(x[i],a*n+1):
            pat[j][k]+=pat[j-1][k-x[i]]
ans = 0
for i in range(1,n+1):
    ans+=pat[i][i*a]
print(ans)
