#sからの距離を求める。
def grid_distance(s):
    dist = [10**24 for i in range((H+2)*(W+2))]
    visited = [0 for i in range((H+2)*(W+2))]
    visited[s]=1
    dist[s] = 0
    q=deque()
    q.append(s)
    while q!=[]:
        v =  q.popleft()
        tonari = [v+1,v-1,v+(W+2),v-(W+2)]
        for i in tonari:
            if visited[i]==1:
                continue
            visited[i]=1
            dist[v] = dist[v]+1
            q.append(i)
               