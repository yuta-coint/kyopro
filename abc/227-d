n,k =map(int,input().split())
a = list(map(int,input().split()))
a.sort()
a1 = a[:n-k]
asum = sum(a1)
a2 = a[n-k:]
ans = a2[0]
for i in range(1,k):
    s = (a2[i]-a2[i-1])*i
    if s<=asum:
        asum-=s
        ans=a2[i]
    else:
        ans+=asum//i
        asum=0
        break
if asum>0:
    ans+=asum//k
print(ans)
