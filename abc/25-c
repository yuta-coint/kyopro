import copy
n = 9
point=[]
for i in range(5):
    m = list(map(int,input().split()))
    point+=m
pair = [(0,3),(1,4),(2,5),(3,6),(4,7),(5,8),(0,1),(1,2),(3,4),(4,5),(6,7),(7,8)]
def blu(i,pre):
    if i < n:
        if i & 1:
            a = 10**9
        else:
            a = 0
        for j in range(9):
            if pre[j]==2:
                k = copy.copy(pre)
                k[j]=i&2
                if i & 1:
                    a = min(a,blu(i+1,k))
                else:
                    a = max(a,blu(i+1,k))
        return(a)
    else:
        nao = 0
        for j in range(12):
            if pre[pair[j][0]]==pre[pair[j][1]]:
                nao+=point[j]
        return(nao)
hiro = blu(0,[2,2,2,2,2,2,2,2,2])
ko = sum(point)-hiro
print(hiro)
print(ko)
