###普通の組み合わせ
def pcq(p,q):
    com = 1
    for i in range(q):
        com *= p-i
        com //= i+1
    return(com)





mod = 10**9+7
##mの(pow乗)
def bigpower(base,pow):
    num = 1
    for i in reversed(range(len(bin(pow)))):
        num = num*num%mod
        if pow>>i & 1:
            num = num*base%mod
        i+=1
    return(num)

###組み合わせをmodで割った余り（pCq、計算量pq）
def pcq(p,q):
    com = 1
    for i in range(q):
        com *= bigpower(i+1,mod-2)
        com *= p-i
        com %= mod
    return(com)
