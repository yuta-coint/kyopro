import sys
input = sys.stdin.readline
n,m = map(int,input().split())
friend = [[0 for i in range(n*2)] for j in range(n*2)]
mod = 998244353
#[i,j]での理想的な値
pattern = [[0 for i in range(n*2)] for i in range(n*2)]
for i in range(m):
    a,b = map(int,input().split())
    friend[a-1][b-1]=1
    friend[b-1][a-1]=1
for i in range(2*n-1):
    if friend[i][i+1]==1:
        pattern[i][i+1]=1
#[i,j)間での値を範囲が小さい順に評価していく
for r in range(3,2*n+1,2):
    for i in range(2*n-1-r):
        j=i+r
        if friend[i][i+1]==1:
            pattern[i][j]+=pattern[i+2][j]
            pattern[i][j]%=mod
        if friend[j-1][j]==1:
            pattern[i][j]+=pattern[i][j-2]
            pattern[i][j]%=mod
        if friend[i+1][j-2]==1:
            pattern[i][j]+=pattern[i+1][j-1]
            pattern[i][j]%=mod
#print(pattern)
print(pattern[0][2*n-1])
