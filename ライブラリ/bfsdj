N= int(input())
from collections import deque
def bfsdj(r):
    hq = deque()
    hq.append((0, r)) #(distance, node)
    dist = [-1] * N
    dist[r] = 0
    while hq!=[]:
        v = hq.popleft()[1] # ノードを pop する
        #print(v)
        for i in G[v]: # ノード v に隣接しているノードに対して
            if dist[i]==-1:
                dist[i] = dist[v] + 1
                hq.append((dist[i], i))
        #print(dist)
    return dist

