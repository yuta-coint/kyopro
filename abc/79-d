from heapq import heappush, heappop
INF = 10 ** 9
h, w = map(int,input().split())
adj = [list(map(int,input().split())) for i in range(10)]
dist = [INF] * 10
hq = [(0, 1)] #(distance, node)
dist[1] = 0
seen = [False] * 10 # ノードが確定済みかどうか
while hq!=[]:
    v = heappop(hq)[1] # ノードを pop する
    #print(v)
    seen[v] = True
    for i in range(10): # ノード v に隣接しているノードに対して
        if seen[i] == False and dist[v] + adj[i][v] < dist[i]:
            dist[i] = dist[v] + adj[i][v]
            heappush(hq, (dist[i], i))
    #print(dist)
count = [0 for i in range(10)]
for i in range(h):
    a = list(map(int,input().split()))
    for j in range(w):
        count[abs(a[j])] += 1
ans = 0
#print(dist)
for i in range(10):
    ans += count[i]*dist[i]
print(ans)
