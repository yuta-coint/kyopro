#ax+by=gcd(a,b) の整数解 (x,y) ただし、絶対値の和を最小化
#両方正じゃないと動かない
def EEA(a,b):
    if a == 0:
        return(0,1)
    elif b == 0:
        return(1,0)
    elif a>=b:
        r = a//b
        p,q = EEA(a%b,b)
        return(p,q-r*p)
    else:
        r = b//a
        p,q = EEA(a,b%a)
        return(p-r*q,q)
a,b = map(int,input().split())
print(*EEA(a,b))
