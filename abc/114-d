pn=[2];A=1000
for L in range(3,100):
    chk=True
    for L2 in pn:
        if L%L2 == 0:chk=False
    if chk:pn.append(L)
n = int(input())
power = []
for i in pn:
    j = n
    k = 0
    while j>0:
        j //= i
        k += j
    power.append(k)
#(2,4,4)(4,14)(2,24)(74)
cnt = [0,0,0,0,0]
ans = 0
for i in power:
    if i>=2:cnt[0] +=1
    if i>=4:cnt[1] +=1
    if i>=14:cnt[2] +=1
    if i>=24:cnt[3] +=1
    if i>=74:cnt[4] +=1
ans += (cnt[1])*(cnt[1]-1)*(cnt[0]-2)//2
ans += (cnt[2])*(cnt[1]-1)
ans += (cnt[3])*(cnt[0]-1)
ans += cnt[4]
print(ans)
