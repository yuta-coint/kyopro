import math
def divisor(n):
    p = math.sqrt(n)
    p = math.floor(p)
    div = []
    for i in range(1,p+1):
        if n%i == 0:
            div.append(i)
            div.append(n//i)
    return(div)

n = int(input())
a = list(map(int,input().split()))
div0 = divisor(a[0])
div1 = divisor(a[1])
div0 = set(div0)|set(div1)
ans = 0
for i in div0:
    if ans >= i:
        continue
    cnt = 0
    for j in range(n):
        if a[j]%i == 0:
            cnt+=1
    if cnt >= n-1:
        ans = i
print(ans)
