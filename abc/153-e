H,N = map(int,input().split())
#残り体力hに置ける必要魔力
a,b = map(int,input().split())
memo = [0]
for i in range(1,H+1):
    if i <= a:
         memo.append(b)
    else:
         memo.append(memo[i-a]+b)


for n in range(N-1):
    a,b = map(int,input().split())
    for h in range(H+1):
        if h>=a:
            if memo[h-a]+b < memo[h]:
                memo[h]=memo[h-a]+b
        elif memo[h]>b:
            memo[h] = b
print(memo[H])
