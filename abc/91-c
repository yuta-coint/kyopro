N = int(input())
c6 = 1
c9 = 1
coin = [1]
while c6<=N:
    c6*=6
    coin.append(c6)
while c9<=N:
    c9*=9
    coin.append(c9)
coin.sort()
count = [0]
for i in range(1,N+1):
    t = 0
    ans = 10**9
    while coin[t]<=i:
        if ans>count[i-coin[t]]+1:
            ans = count[i-coin[t]]+1
        t += 1
    count.append(ans)
print(count[N])
