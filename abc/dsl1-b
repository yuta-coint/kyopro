n,q = map(int,input().split())
tree = [i for i in range(n)]
weight = [0 for i in range(n)]
def find(i):
    global weight
    if tree[i] == i:
        weight[i]=0
        return i
    else:
        findi = find(tree[i])
        weight[i] += weight[tree[i]]
        y = findi
        return y

def union(a,b,c):
    if tree[a] > tree[b]:
        a,b = b,a
        c = -c
    weight[b]=c
    tree[find(b)] = find(a)

