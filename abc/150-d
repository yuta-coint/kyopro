n,m = map(int, input().split())
a = list(map(int,input().split()))

def gcd(p,q):
    while p>0:
        p,q = q,p
        p = p%q
    return(q)

lcm = 1
cnt = 0
t = a[0]
while t%2==0:
    t = t//2
    cnt+=1
d1 = 2**cnt
d2 = d1*2
check=0
for i in range(n):
    lcm = lcm*a[i]//gcd(lcm,a[i])
    if a[i]%d1!=0 or a[i]%d2==0:
        check=1
if check == 1:
    ans = 0
else:
    m += lcm//2
    ans = m//lcm
print(ans)
