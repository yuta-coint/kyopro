n,m = map(int,input().split())
a = [[]for i in range(2*n)]
for i in range(2*n):
    a[i] = list(input())
def jank(p,q):
    if p == "G" and q == "C":
        return(1)
    elif p == "G" and q == "P":
        return(-1)
    elif p == "C" and q == "P":
        return(1)
    elif p == "C" and q == "G":
        return(-1)
    elif p == "P" and q == "G":
        return(1)
    elif p == "P" and q == "C":
        return(-1)
    else:
        return(0)
rank = [[i,i] for i in range(2*n)]
for i in range(m):
    for j in range(n):
        s = a[rank[2*j][1]][i]
        t = a[rank[2*j+1][1]][i]
        if jank(s,t)==1:
            rank[2*j][0] -= 1000
        elif jank(s,t)==-1:
            rank[2*j+1][0] -= 1000
    rank.sort()
for i in range(2*n):
    print(rank[i][0])
