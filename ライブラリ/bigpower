n,m = map(int,input().split())
mod = 10**9+7
##mの(pow乗)
##mの(pow乗)
def bigpower(base,pow):
    num = 1
    i = len(bin(pow))-3
    while i>=0:
        num = num*num%mod
        if pow>>i & 1==1:
            num = num*base%mod
        i-=1
    return(num)

###組み合わせをmodで割った余り（pCq、計算量pq）
def pcq(p,q):
    com = 1
    for i in range(q):
        com *= bigpower(i+1,mod-2)
        com *= p-i
        com %= mod
    return(com)
###組み合わせをmodで割った余り・クソデカ対応（pCq、計算量pq）
def pcq(p,q):
    powp = 0
    com = 1
    for i in range(q):
        if i+1%mod==0:
            powp-=1
        else:
            com *= bigpower(i+1,mod-2)
        if p-i%mod==0:
            powp += 1
        else:
            com *= p-i
        com %= mod
    return(com,powp)
