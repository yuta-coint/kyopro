import sys
N,e = map(int, sys.stdin.readline().split())
G = [[]for i in range(N+1)]
rG = [[]for i in range(N+1)]
for i in range(e):
    s,t = map(int, sys.stdin.readline().split())
    G[s].append(t)
    rG[t].append(s)
inedge = [len(rG[i]) for i in range(N+1)]
L = []
import heapq
S = []
heapq.heapify(S)
for i in range(1,N+1):
    if inedge[i]==0:
        heapq.heappush(S, i)
while len(S)>0:
    n = heapq.heappop(S)
    L.append(n)
    for i in G[n]:
        inedge[i] -= 1
        if inedge[i] == 0:
            heapq.heappush(S, i)
if len(L)==N:
    print(*L)
else:
    print(-1)
