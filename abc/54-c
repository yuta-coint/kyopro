import itertools
import math
n ,m= map(int,input().split())
arr = [i for i in range(1,n)]
ptn = list(itertools.permutations(arr))
path=[]
for i in range(m):
     a= list(map(int,input().split()))
     path.append(a)

ans = 0
for p in ptn:
    flag = 1
    if [1, p[0]+1] in path:
        flag = flag
    else:
        flag = 0
    for i in range(n-2):
        if [p[i]+1, p[i+1]+1] in path or [p[i+1]+1, p[i]+1] in path:
            flag = flag
        else:
            flag = 0
    if flag == 1:
        ans = ans+1
print(ans)
