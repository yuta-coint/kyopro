n,q = map(int,input().split())
BIT = [0 for i in range(n+1)]
def add(i,x):
    while i<=n:
        BIT[i]+=x
        i += (i&-i)

def getSum(x):
    i = x
    gs = 0
    while i>0:
        gs+=BIT[i]
        i -= (i&-i)
    return gs

def raq(x1,x2,d):
    add(x1,d)
    add(x2+1,-d)

