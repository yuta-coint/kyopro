import sys
sys.setrecursionlimit(10**6)
n = int(input())
G = [[]for i in range(n+1)]
for i in range(n-1):
    a,b,c = map(int,input().split())
    G[a].append([b,c])
    G[b].append([a,c])
q,k = map(int,input().split())
depth = [-1 for i in range(n+1)]
depth[k]=0
def dfs(v):
    for i in G[v]:
        if depth[i[0]]==-1:
            depth[i[0]]=depth[v]+i[1]
            dfs(i[0])
dfs(k)
for i in range(q):
    x,y = map(int,input().split())
    print(depth[x]+depth[y])
