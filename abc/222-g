def factorization(numa):
    arr = []
    hp = numa
    for i in range(2, int(-(-numa**0.5//1))+1):
        powa = 0
        while hp%i==0:
            hp //= i
            arr.append(i)
    if hp>1:
        arr.append(hp)
    return(arr)
def phi(numb):
    phin = numb
    fac = factorization(numb)
    p = set(fac)
    for i in p:
        phin *= i-1
        phin //= i
    return(phin)
def divisors(m):
    if m == 2:
        return([1,2])
    div = []
    for i in range(1, int(-(-m**0.5//1))+1):
        if m%i==0:
            div.append(i)
            if i!= m//i:
                div.append(m//i)
    return(sorted(div))
##mの(pow乗)
def bigpower(base,pow,mod):
    num = 1
    devide = []
    while pow>0:
        if pow%2==0:
            devide.append(2)
            pow = pow//2
        else:
            devide.append(1)
            pow -= 1
    devide.reverse()
    lend = len(devide)
    for i in range(lend):
        if devide[i]==2:
            num = num*num%mod
        else:
            num = num*base%mod
    return(num)
