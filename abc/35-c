n,q = map(int,input().split())
ans = [0 for i in range(n)]
c = [0 for i in range(n)]
for i in range(q):
    l,r = map(int,input().split())
    c[l-1] = (c[l-1]+1)%2
    if r!=n:
        c[r] = (c[r]+1)%2
ans[0] = c[0]
for i in range(1,n):
    ans[i] = (ans[i-1]+c[i])%2
print(*ans,sep = "")
