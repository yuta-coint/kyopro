v,q = map(int,input().split())
graph = []
tree = [i for i in range(v)]

def find(i):
    if tree[i] == i:
        return i
    else:
        tree[i]= find(tree[i])
        return find(tree[i])

def union(a,b):
    if tree[a] > tree[b]:
        a,b = b,a
    tree[find(b)] = find(a)
for i in range(q):
    com,x,y = map(int,input().split())
    if com == 1:
        if find(x) == find(y):
            print(1)
        else:
            print(0)
    else:
        union(x,y)
